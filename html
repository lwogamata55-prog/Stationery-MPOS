const LKEY = 'mpos_v2';

/* ===== LOCAL STORAGE BACKUP ===== */
function saveLocal(){ try{ localStorage.setItem(LKEY, JSON.stringify(S)); }catch(e){} }
function loadLocal(){
  try{
    const d = JSON.parse(localStorage.getItem(LKEY)||'null');
    if(d) Object.assign(S, d);
  }catch(e){}
}

/* ===== FIREBASE SYNC ===== */
function setSdot(state){
  const d = document.getElementById('sdot');
  d.className = 'sdot';
  if(state==='live') d.classList.add('live');
  else if(state==='sync') d.classList.add('sync');
}

function pushToFirebase(){
  setSdot('sync');
  S.lastUpdated = new Date().toISOString();
  dataRef.set(S)
    .then(() => setSdot('live'))
    .catch(() => setSdot(''));
}

dataRef.on('value', (snapshot) => {
  const val = snapshot.val();
  if(val){
    Object.assign(S, val);
    saveLocal();
    renderAll();
  } else {
    pushToFirebase();
  }
  setSdot('live');
}, (error) => {
  console.warn('Firebase read failed', error);
  setSdot('');
});

/* ===== RENDER ===== */
function renderAll(){
  renderProductsList();
  renderPosGrid();
  renderLedger();
  renderStats();
  renderCashTransactions();
  updateCashBalance();
}
function renderProductsList(){
  const list = document.getElementById('products-list');
  if(!list) return;
  if(!S.products.length){
    list.innerHTML = '<div class="muted" style="text-align:center;padding:40px;">No products yet</div>';
    return;
  }
  list.innerHTML = S.products.map(p => `
    <div class="prod-card">
      <div class="prod-ico">📄</div>
      <div class="prod-info">
        <div class="prod-name">${escH(p.name)}</div>
        <div class="prod-meta">${escH(p.category||'')} ${p.description ? '· '+escH(p.description) : ''}</div>
      </div>
      <div style="text-align:right;">
        <div class="prod-price">UGX ${fmtN(p.price)}</div>
        <div class="prod-stock">Stock: ${p.stock}</div>
      </div>
      <div class="prod-actions">
        <button class="btn-icon" style="width:32px;height:32px;" onclick="editProduct('${p.id}')">✏️</button>
        <button class="btn-icon" style="width:32px;height:32px;color:var(--red);" onclick="deleteProduct('${p.id}')">🗑</button>
      </div>
    </div>
  `).join('');
}
function renderPosGrid(){
  const grid = document.getElementById('pos-grid');
  if(!grid) return;
  if(!S.products.length){
    grid.innerHTML = '<div class="muted" style="text-align:center;padding:20px;">No products available</div>';
    return;
  }
  grid.innerHTML = S.products.map(p => `
    <div class="pos-item" onclick="addToCart('${p.id}')">
      <div class="pos-item-name">${escH(p.name)}</div>
      <div class="pos-item-price">UGX ${fmtN(p.price)}</div>
      <div class="pos-item-stock">Stock: ${p.stock}</div>
    </div>
  `).join('');
}
function renderCart(){
  const container = document.getElementById('cart-container');
  if(!container) return;
  if(cart.length === 0){
    container.innerHTML = '<div class="muted" style="text-align:center;">Cart is empty</div>';
    document.getElementById('cart-total').innerText = 'Total: UGX 0';
    return;
  }
  let total = 0;
  container.innerHTML = cart.map((item, idx) => {
    total += item.price * item.quantity;
    return `
      <div class="cart-item">
        <div class="cart-item-info">
          <div class="cart-item-name">${escH(item.name)}</div>
          <div class="cart-item-price">UGX ${fmtN(item.price)} each</div>
        </div>
        <input type="number" class="inp cart-item-qty" value="${item.quantity}" min="1" max="${item.maxStock}" onchange="updateCartQty(${idx}, this.value)">
        <button class="btn-icon" style="width:36px;height:36px;" onclick="removeFromCart(${idx})">✕</button>
      </div>
    `;
  }).join('');
  document.getElementById('cart-total').innerText = `Total: UGX ${fmtN(total)}`;
}
function renderLedger(){
  const list = document.getElementById('ledger-list');
  if(!list) return;
  if(!S.sales.length){
    list.innerHTML = '<div class="muted" style="text-align:center;padding:40px;">No sales recorded</div>';
    return;
  }
  list.innerHTML = S.sales.map(s => `
    <div class="sale-card">
      <div class="sale-header">
        <span class="sale-date">${s.date}</span>
        <span class="sale-total">UGX ${fmtN(s.total)}</span>
      </div>
      <div class="sale-items">${s.items.map(i => `${i.quantity} × ${escH(i.name)}`).join(', ')}</div>
    </div>
  `).join('');
}
function renderStats(){
  // Top selling items (all time)
  const itemCounts = {};
  S.sales.forEach(sale => {
    sale.items.forEach(item => {
      if(!itemCounts[item.productId]) itemCounts[item.productId] = { name: item.name, qty: 0 };
      itemCounts[item.productId].qty += item.quantity;
    });
  });
  const topItems = Object.values(itemCounts).sort((a,b) => b.qty - a.qty).slice(0,5);
  const topDiv = document.getElementById('top-items-list');
  if(topDiv){
    if(topItems.length){
      topDiv.innerHTML = topItems.map(t => `
        <div class="top-item">
          <span class="top-item-name">${escH(t.name)}</span>
          <span class="top-item-qty">${t.qty} sold</span>
        </div>
      `).join('');
    } else {
      topDiv.innerHTML = '<div class="muted">No sales data</div>';
    }
  }
  
  // Low stock alert (stock <= 3)
  const lowStock = S.products.filter(p => p.stock <= 3);
  const lowDiv = document.getElementById('low-stock-list');
  if(lowDiv){
    if(lowStock.length){
      lowDiv.innerHTML = lowStock.map(p => `
        <div class="top-item">
          <span class="top-item-name">${escH(p.name)}</span>
          <span class="top-item-qty">Stock: ${p.stock}</span>
        </div>
      `).join('');
    } else {
      lowDiv.innerHTML = '<div class="muted">All stock levels are healthy</div>';
    }
  }
  
  // Suggested purchase based on average daily sales (last 30 days)
  const thirtyDaysAgo = new Date();
  thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
  const recentSales = S.sales.filter(s => new Date(s.date) >= thirtyDaysAgo);
  const recentCounts = {};
  recentSales.forEach(sale => {
    sale.items.forEach(item => {
      if(!recentCounts[item.productId]) recentCounts[item.productId] = { name: item.name, qty: 0 };
      recentCounts[item.productId].qty += item.quantity;
    });
  });
  const suggestions = [];
  S.products.forEach(p => {
    const sold = recentCounts[p.id] ? recentCounts[p.id].qty : 0;
    const avgDaily = sold / 30;
    const daysLeft = p.stock / (avgDaily || 1);
    if(daysLeft < 14){ // suggest if less than 2 weeks of stock
      suggestions.push({ name: p.name, stock: p.stock, avgDaily: avgDaily.toFixed(1), daysLeft: daysLeft.toFixed(0) });
    }
  });
  const suggestDiv = document.getElementById('suggested-purchase');
  if(suggestDiv){
    if(suggestions.length){
      suggestDiv.innerHTML = suggestions.map(s => `
        <div class="top-item">
          <span class="top-item-name">${escH(s.name)}</span>
          <span class="top-item-qty">Stock: ${s.stock} | Days left: ${s.daysLeft}</span>
        </div>
      `).join('');
    } else {
      suggestDiv.innerHTML = '<div class="muted">No urgent restock needed</div>';
    }
  }
}
function renderCashTransactions(){
  const list = document.getElementById('cash-transactions-list');
  if(!list) return;
  let filtered = filterCashByPeriod();
  if(!filtered.length){
    list.innerHTML = '<div class="muted" style="text-align:center;padding:20px;">No transactions in this period</div>';
    return;
  }
  list.innerHTML = filtered.map(t => {
    let typeClass = '';
    if(t.type === 'opening') typeClass = 'type-opening';
    else if(t.type === 'cash_in') typeClass = 'type-cash_in';
    else if(t.type === 'cash_out') typeClass = 'type-cash_out';
    else if(t.type === 'expense') typeClass = 'type-expense';
    let sign = (t.type === 'cash_in' || t.type === 'opening') ? '+' : '-';
    return `
      <div class="cash-card">
        <div>
          <span class="cash-type ${typeClass}">${t.type}</span>
          <div class="cash-desc">${escH(t.description || '')} <span class="cash-date">${t.date}</span></div>
        </div>
        <div class="cash-amount" style="color:${(t.type==='cash_in'||t.type==='opening')?'var(--green)':'var(--red)'}">${sign} UGX ${fmtN(t.amount)}</div>
      </div>
    `;
  }).join('');
}
function updateCashBalance(){
  // Calculate current balance based on all cash transactions (including sales as cash_in)
  // We'll treat each sale as an automatic cash_in entry? For simplicity, we'll not double-count.
  // Instead, we'll compute cash balance as: opening + cash_in - cash_out - expense + sales total.
  const opening = S.cashTransactions.filter(t => t.type === 'opening').reduce((sum,t) => sum + t.amount, 0);
  const cashIn = S.cashTransactions.filter(t => t.type === 'cash_in').reduce((sum,t) => sum + t.amount, 0);
  const cashOut = S.cashTransactions.filter(t => t.type === 'cash_out').reduce((sum,t) => sum + t.amount, 0);
  const expenses = S.cashTransactions.filter(t => t.type === 'expense').reduce((sum,t) => sum + t.amount, 0);
  const salesTotal = S.sales.reduce((sum,s) => sum + s.total, 0);
  const balance = opening + cashIn - cashOut - expenses + salesTotal;
  document.getElementById('cash-balance').innerText = `UGX ${fmtN(balance)}`;
}
function filterCashByPeriod(){
  const now = new Date();
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  const startOfWeek = new Date(today);
  startOfWeek.setDate(today.getDate() - today.getDay() + (today.getDay()===0?-6:1)); // Monday
  const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);
  const startOfYear = new Date(now.getFullYear(), 0, 1);
  
  return S.cashTransactions.filter(t => {
    const d = new Date(t.date);
    if(cashPeriod === 'day') return d >= today;
    if(cashPeriod === 'week') return d >= startOfWeek;
    if(cashPeriod === 'month') return d >= startOfMonth;
    if(cashPeriod === 'year') return d >= startOfYear;
    return true; // all
  }).sort((a,b) => new Date(b.date) - new Date(a.date));
}
function setCashPeriod(period){
  cashPeriod = period;
  let label = { day:'Today', week:'This Week', month:'This Month', year:'This Year', all:'All Time' }[period];
  document.getElementById('cash-period').innerText = label;
  renderCashTransactions();
}

