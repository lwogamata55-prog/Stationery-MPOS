  if(btoa(old) !== S.posPasswordHash){
    toast('Current POS password wrong','#dc3545'); return;
  }
  if(nw.length < 4){
    toast('New password min 4 chars','#dc3545'); return;
  }
  if(nw !== cfm){
    toast('Passwords do not match','#dc3545'); return;
  }
  S.posPasswordHash = btoa(nw);
  pushToFirebase();
  document.getElementById('pos-pwd-old').value = '';
  document.getElementById('pos-pwd-new').value = '';
  document.getElementById('pos-pwd-cfm').value = '';
  toast('POS password changed','#FFC107');
}
