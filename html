/* ===== SHARE ===== */
let shareOpen=false;
function toggleShare(){
  shareOpen = !shareOpen;
  const b = document.getElementById('share-banner');
  if(shareOpen){
    b.classList.add('show');
    refreshShareUrl();
  } else b.classList.remove('show');
}
function refreshShareUrl(){
  const url = location.href.split('#')[0];
  document.getElementById('share-inp').value = url;
}
function doCopy(){
  const v = document.getElementById('share-inp').value;
  navigator.clipboard?.writeText(v).then(()=>{
    const btn = document.getElementById('copy-b');
    btn.textContent = 'Copied ✓';
    btn.classList.add('ok');
    setTimeout(()=>{
      btn.textContent = 'Copy';
      btn.classList.remove('ok');
    },2500);
    toast('Link copied','#FFC107');
  }).catch(()=>toast('Manual copy','#FFC107'));
}

/* ===== UTILS ===== */
function toast(msg,color='#FFC107'){
  const w=document.getElementById('twrap');
  const el=document.createElement('div'); el.className='toast';
  const dot=document.createElement('div'); dot.className='tdot'; dot.style.background=color; dot.style.boxShadow='0 0 8px '+color;
  const sp=document.createElement('span'); sp.textContent=msg;
  el.append(dot,sp); w.appendChild(el);
  setTimeout(()=>{el.classList.add('out'); setTimeout(()=>el.remove(),300); },3200);
}
function escH(s){ return String(s).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[m]); }
function fmtN(n){ return Number(n).toLocaleString('en-UG'); }
function openOv(id){ document.getElementById(id).classList.add('on'); }
function closeOv(id){ document.getElementById(id).classList.remove('on'); }
function maybeClose(e,id){ if(e.target === document.getElementById(id)) closeOv(id); }
function togglePwd(id){ const el=document.getElementById(id); if(el) el.type = el.type==='password'?'text':'password'; }
function setEl(id,v){ const e=document.getElementById(id); if(e) e.innerHTML=v; }

function goTab(name,btn){
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('on'));
  document.querySelectorAll('.ni').forEach(n=>n.classList.remove('on'));
  document.getElementById('t-'+name).classList.add('on');
  (btn||document.getElementById('ni-'+name)).classList.add('on');
  curTab = name;
  if(name==='products') renderProductsList();
  if(name==='pos') { renderPosGrid(); renderCart(); }
  if(name==='ledger') renderLedger();
  if(name==='stats') renderStats();
  if(name==='cash') { renderCashTransactions(); updateCashBalance(); }
}

/* ===== INIT ===== */
function init(){
  loadLocal();
  refreshShareUrl();
  // Firebase listener already attached
}
init();
